<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ProgressBar
        android:id="@+id/homeLoading"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/accent" />

    <LinearLayout
        android:id="@+id/homeError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/error_generic"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/homeRetry"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/control_height"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_button"
            android:minWidth="120dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="@string/retry"
            android:textColor="@drawable/text_button" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/homeContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_margin"
        android:paddingTop="18dp"
        android:paddingEnd="@dimen/page_margin"
        android:visibility="gone">

        <TextView
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_search_bar"
            android:clickable="true"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="14dp"
            android:drawableTint="@color/text_secondary"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:singleLine="true"
            android:text="@string/search_hint"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/homeRows"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="12dp" />
    </LinearLayout>
</FrameLayout>
