<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/playerLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <ProgressBar
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:indeterminateTint="@color/accent" />

        <TextView
            android:id="@+id/playerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxWidth="420dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/starting_stream"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/playerError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/playerErrorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/error_stream"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <Button
            android:id="@+id/playerFixWebview"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/control_height"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_button"
            android:minWidth="140dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="@string/fix_webview"
            android:textColor="@drawable/text_button"
            android:visibility="gone" />

        <Button
            android:id="@+id/playerRetry"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/control_height"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_button"
            android:minWidth="120dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="@string/retry"
            android:textColor="@drawable/text_button" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/press_back_to_exit"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/webviewWarning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="48dp"
        android:background="@drawable/bg_badge"
        android:padding="10dp"
        android:text="@string/old_webview"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:visibility="gone" />
</FrameLayout>
